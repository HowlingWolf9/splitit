{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capabilities for SplitIt desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-start_oauth_listener",
    "allow-save_backup_file",
    "allow-read_backup_file",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "opener:default"
  ]
}
